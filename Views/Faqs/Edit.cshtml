@model CSMS.Models.Faq

@{
    ViewData["Title"] = "Edit";
}
<div class="container">

    <h2>Edit a Frequently Asked Question</h2>

    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Edit" asp-route-pk="@Model.Pk" method="post">
            @* <form asp-action="Edit" asp-route-id="@Model.Pk"> *@
            @* <form asp-action="Edit"> *@
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Pk" />
                <div class="form-group">
                    <label asp-for="ID" class="control-label" style="font-weight:bold"></label>- (Serial Number for the order this questions appears in its respective category)
                    <input asp-for="ID" class="form-control"  />
                    <span asp-validation-for="ID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Question" class="control-label" style="font-weight:bold"></label>
                    <textarea asp-for="Question" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Question" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Answer" class="control-label" style="font-weight:bold"></label>
                    <textarea asp-for="Answer" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Answer" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Category" class="control-label" style="font-weight:bold"></label>
                    <br />Current Options are:
                    <ul>
                        <li>General Questions (Pre-Survey)</li>
                        <li>Questions During the survey</li>
                        <li>Technical Questions about Post Adjustment and</li>
                        <li>Geneva-specific questions</li>
                        <li>or Add a new Category ...</li>
                    </ul>
                    <input asp-for="Category" class="form-control" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="form-group">
                     <label asp-for="Qtype" class="control-label"><b>Category id</b></label>
                    <br />Allowed Options are:
                    <ul>
                        <li>Enter 1 for General Questions (Pre-Survey)</li>
                        <li>Enter 2 for Questions During the survey</li>
                        <li>Enter 3 for Technical Questions about Post Adjustment and</li>
                        <li>Enter 4 for Geneva-specific questions</li>
                        <li>Enter a different number for a new category</li>
                    </ul>
                    <input asp-for="Qtype" class="form-control" />
                    <span asp-validation-for="Qtype" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="GroupId" class="control-label"><b>This question applies to: </b></label>
                    <br />Available Options are:
                    <ul>
                        <li>Enter 0 for questions that apply to both Housing and Place-to-Place surveys</li>
                        <li>Enter 1 for questions that apply exclusively to Housing surveys</li>
                        <li>Enter 12 for questions that apply exclusively to Place-to-Place surveys</li>
                        <li>Enter 999 for questions that you want to hide</li>

                    </ul>
                    <input asp-for="GroupId" class="form-control" />
                    <span asp-validation-for="GroupId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-sm btn-info" />
                    <a asp-action="Index" class="btn btn-sm btn-info">Back to FAQs</a>
                </div>
            </form>
        </div>
    </div>


</div>