@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<CSMS.Models.Faq>

@{
    bool role = HttpContextAccessor.HttpContext.Session.GetString("_userRole") == "SiteAdmin";
    bool hq = HttpContextAccessor.HttpContext.Session.GetString("_dsGroupToDisplay") == "0";
}

<!-- HOUSING -->

<div class="card">
    <div class="card-body">

        <div class="row">

            <div class="col-md-1">
            </div>

            <div class="col-md-10">

                @if (role)
                {
                    <div>
                        <a asp-action="Create"
                           class="btn btn-sm btn-primary">
                            Add New Question
                        </a>
                    </div>

                    <br />
                }

                <accordion>

                    @foreach (var category in Model
                                        .Select(x => x.Category)
                                        .Where(x => !string.IsNullOrWhiteSpace(x))
                                        .Distinct())
                    {
                        if (!category.Equals("Geneva-specific questions") || hq)
                        {
                            var categoryItems = Model
                            .Where(x =>
                            x.Category == category &&
                            (x.GroupId.ToString() == "0" ||
                            x.GroupId.ToString() == "1") &&
                            (
                            role ||
                            x.Qtype.ToString() != "4" ||
                            hq
                            ))
                            .ToList();

                            if (categoryItems.Any())
                            {
                                <br />

                                <h3 class="card-title">
                                    @category
                                </h3>

                                <br />

                                var ii = 1;

                                foreach (var item in categoryItems)
                                {
                                    string chck = "hh-" + item.Pk.ToString();

                                    if (role)
                                    {
                                        <div>

                                            <a asp-action="Edit"
                                               asp-route-pk="@item.Pk"
                                               class="btn btn-sm btn-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.Pk"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Pk"
                                               class="btn btn-sm btn-danger"
                                               style="float:right">
                                                Delete
                                            </a>

                                        </div>
                                    }

                                    <div class="tabs">
                                        <div class="tab">

                                            <input type="checkbox"
                                                   id="@chck">

                                            <label class="tab-label"
                                                   style="font-weight: normal; font-size:medium;"
                                                   for="@chck">
                                                @ii - @Html.Raw(item.Question)
                                            </label>

                                            <div class="tab-content">
                                                @Html.Raw(item.Answer)
                                            </div>

                                        </div>
                                    </div>

                                    ii++;
                                }
                            }
                        }
                    }

                </accordion>


                @if (role)
                {
                    <br />

                    <hr />

                    <h3 class="card-title">
                        Hidden Questions
                    </h3>

                    <h5>
                        Change GroupId from the hidden value to:
                    </h5>

                    <ul>
                        <li>
                            <strong>0</strong> - Applicable to both PP and Housing
                        </li>
                        <li>
                            <strong>1</strong> - Applicable to Housing only
                        </li>
                        <li>
                            <strong>12</strong> - Applicable to PP only
                        </li>
                    </ul>

                    <br />

                    var hiddenItems = Model
                    .Where(x =>
                    x.GroupId.ToString() != "0" &&
                    x.GroupId.ToString() != "1" &&
                    x.GroupId.ToString() != "12")
                    .ToList();

                    foreach (var item in hiddenItems)
                    {
                        string hiddenCheck = "hidden-" + item.Pk.ToString();

                        <div>

                            <a asp-action="Edit"
                               asp-route-pk="@item.Pk"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Pk"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Pk"
                               class="btn btn-sm btn-danger"
                               style="float:right">
                                Delete
                            </a>

                        </div>

                        <div class="tabs">
                            <div class="tab">

                                <input type="checkbox"
                                       id="@hiddenCheck">

                                <label class="tab-label"
                                       style="font-weight: normal; font-size:medium;"
                                       for="@hiddenCheck">
                                    @Html.Raw(item.Question)
                                </label>

                                <div class="tab-content">
                                    @Html.Raw(item.Answer)
                                </div>

                            </div>
                        </div>
                    }
                }


                <br />

                @if (role)
                {
                    <div>
                        <a asp-action="Create"
                           class="btn btn-sm btn-primary">
                            Add New Question
                        </a>
                    </div>
                }

            </div>

            <div class="col-md-1">
            </div>

        </div>

    </div>
</div>