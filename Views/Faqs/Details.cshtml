@model CSMS.Models.Faq

@{
    ViewData["Title"] = "Details";
}





        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-10">

                <div>
                    <h3 class="card-title">FAQs Detail</h3>
                    <hr />

                    
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.ID) - (Serial Number for the order this questions appears in its respective category)
                        </dt>
                        <dd style="color:brown; font-weight:bold">
                           
                    <textarea class="form-control" > @Html.DisplayFor(model => model.ID)</textarea>
                        </dd>
                        <dt>
                            <b>Question</b>
                        </dt>
                        <dd style="color:brown; font-weight:bold">
                            
                    <textarea class="form-control" rows="10">@Html.DisplayFor(model => model.Question)</textarea>
                        </dd>
                        <dt>
                            <b>Answer</b>
                        </dt>
                        <dd style="color:brown; font-weight:bold">
                            
                    <textarea class="form-control" rows="10">@Html.DisplayFor(model => model.Answer)</textarea>
                        </dd>
                        <dt>
                            <b>Category</b>
                        </dt>
                        <ul>
                                <li>General Questions (Pre-Survey)</li>
                                <li>Questions During the survey</li>
                                <li>Technical Questions about Post Adjustment and</li>
                                <li>Geneva-specific questions</li>
                                <li>or Add a new Category ...</li>
                            </ul>


                        <dd style="color:brown; font-weight:bold">
                            
                    <textarea class="form-control" >@Html.DisplayFor(model => model.Category)</textarea>
                        </dd>
                        <dt>
                            <b>Category ID</b>
                        </dt>
                        <ul>
                                <li> 1 - for General Questions (Pre-Survey)</li>
                                <li> 2 - for Questions During the survey</li>
                                <li> 3 - for Technical Questions about Post Adjustment and</li>
                                <li> 4 - for Geneva-specific questions etc </li>
                                
                            </ul>

                        <dd style="color:brown; font-weight:bold">
                            
                    <textarea class="form-control">@Html.DisplayFor(model => model.Qtype)</textarea>
                        </dd>
                        <dt>
                            <b>Key to the codes used:</b> 
                        </dt>
                        <ul>
                                <li> 0 - for questions that apply to both Housing and Place-to-Place surveys</li>
                                <li> 1 - for questions that apply exclusively to Housing surveys</li>
                                <li> 12 - for questions that apply exclusively to Place-to-Place surveys</li>

                            </ul>
                        
                        <dd style="color:brown; font-weight:bold" >
                           
                    <textarea class="form-control" > @Html.DisplayFor(model => model.GroupId)</textarea>
                        </dd>
                    </dl>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-pk="@Model.Pk" class="btn btn-primary">Edit</a>
                    <a asp-action="Index" class="btn btn-info">Back to FAQs</a>
                </div>


            </div>
            <div class="col-md-1">
            </div>
        </div>




