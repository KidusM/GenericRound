@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<CSMS.Models.Faq>

@{
    bool isSiteAdmin =
        HttpContextAccessor.HttpContext.Session.GetString("_userRole") == "SiteAdmin";

    bool hq =
        HttpContextAccessor.HttpContext.Session.GetString("_dsGroupToDisplay") == "0";
}

<div class="card">
    <div class="card-body">

        <div class="row">

            <div class="col-md-1">
            </div>

            <div class="col-md-10">

                @if (isSiteAdmin)
                {
                    <div>
                        <a asp-action="Create"
                           class="btn btn-sm btn-primary">
                            Add New Question
                        </a>
                    </div>

                    <br />
                }

                <accordion>

                    @foreach (var category in Model
                                        .Select(x => x.Category)
                                        .Where(x => !string.IsNullOrWhiteSpace(x))
                                        .Distinct())
                    {
                        if (category != "Geneva-specific questions" || hq)
                        {
                            var categoryItems = Model
                            .Where(x =>
                            x.Category == category &&
                            (x.GroupId.ToString() == "0" ||
                            x.GroupId.ToString() == "12") &&
                            (
                            isSiteAdmin ||
                            x.Qtype.ToString() != "4" ||
                            hq
                            ))
                            .ToList();

                            if (categoryItems.Any())
                            {
                                <br />

                                <h3 class="card-title">
                                    @category
                                </h3>

                                <br />

                                var ii = 1;

                                foreach (var item in categoryItems)
                                {
                                    string chck =
                                    "pp-" +
                                    item.Pk.ToString();

                                    if (isSiteAdmin)
                                    {
                                        <div>

                                            <a asp-action="Edit"
                                               asp-route-pk="@item.Pk"
                                               class="btn btn-sm btn-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.Pk"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Pk"
                                               class="btn btn-sm btn-danger"
                                               style="float:right">
                                                Delete
                                            </a>

                                        </div>
                                    }

                                    <div class="tabs">

                                        <div class="tab">

                                            <input type="checkbox"
                                                   id="@chck">

                                            <label class="tab-label"
                                                   style="font-weight:normal; font-size:medium;"
                                                   for="@chck">

                                                @ii - @Html.Raw(item.Question)

                                            </label>

                                            <div class="tab-content">
                                                @Html.Raw(item.Answer)
                                            </div>

                                        </div>

                                    </div>

                                    ii++;
                                }
                            }
                        }
                    }

                </accordion>

                <br />

                @if (isSiteAdmin)
                {
                    <div>

                        <a asp-action="Create"
                           class="btn btn-sm btn-primary">
                            Add New Question
                        </a>

                    </div>
                }

            </div>

            <div class="col-md-1">
            </div>

        </div>

    </div>
</div>