@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<CSMS.Models.Faq>

@{
    ViewData["Title"] = "Frequently Asked Questions";
    Layout = "~/Views/Shared/_accordionLayout.cshtml";

    var dsSurveyType =
        HttpContextAccessor.HttpContext.Session.GetString("_dsSurveyTypeToDisplay");

    var isSiteAdmin =
        HttpContextAccessor.HttpContext.Session.GetString("_userRole") == "SiteAdmin";
}

<br />

<div style="
    min-height: 135px;
    background-image:
        linear-gradient(
            to right,
            rgba(32, 55, 82, 0.8) 0%,
            rgba(32, 55, 82, 0.8) 100%
        ),
        url('@Url.Content("~/assets/images/Banner.png")');
    background-color: #203752;
    background-size: cover;
">

    <div class="row">
        <div class="col-xl-12">
            <div class="text-center">

                <h2 class="card-title text-white"
                    style="padding:40px 0 5px 0">
                    Frequently Asked Questions
                </h2>

                <h4 class="card-title text-center text-white">
                    @HttpContextAccessor.HttpContext.Session.GetString("_dsNameToDisplay")
                </h4>

            </div>

            <br />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">

        <div class="row">

            <div class="col-md-1">
            </div>

            <div class="col-md-10">

                @if (isSiteAdmin)
                {
                    <h2>Place-to-Place Survey Questions</h2>

                    <partial name="_ppFAQ"
                             model="Model" />

                    <br />

                    <h2>Housing Survey Questions</h2>

                    <partial name="_housingFAQ"
                             model="Model" />
                }
                else if (dsSurveyType == "H")
                {
                    <partial name="_housingFAQ"
                             model="Model" />
                }
                else
                {
                    <partial name="_ppFAQ"
                             model="Model" />
                }

            </div>

            <div class="col-md-1">
            </div>

        </div>

    </div>
</div>