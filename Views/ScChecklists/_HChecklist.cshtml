@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@model IEnumerable<CSMS.Models.ScChecklist>

@{
    bool role =
        HttpContextAccessor.HttpContext.Session.GetString("_userRole")
        == "SiteAdmin";

    var checklistItems = role
        ? Model.ToList()
        : Model
            .Where(x =>
                !string.IsNullOrWhiteSpace(x.DsGroup) &&
                x.DsGroup
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(g => g.Trim())
                    .Contains("HH"))
            .ToList();

    int i = 1;
}

<br />

@if (role)
{
    <div class="mb-3">
        <a asp-controller="ScChecklists"
           asp-action="Create"
           class="btn btn-primary">
            Add New Checklist Item
        </a>
    </div>
}

@foreach (var category in checklistItems.Select(x => x.Time)
    .Distinct())
{
    <br />

    <h4 style="font-weight:bold">
        @category
    </h4>

    <br />
    int j = 1;
    @foreach (var item in checklistItems.Where(x => x.Time == category))
    {
        string chck = "hhchck" + i.ToString();

        if (role)
        {
            <div>
                <a asp-action="Edit"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-primary">
                    Edit
                </a>

                <a asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-info">
                    Details
                </a>

                <a asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-danger"
                   style="float:right">
                    Delete
                </a>
            </div>
        }

        <div class="tabs">
            <div class="tab">

                <input type="checkbox"
                       id="@chck">

                <label class="tab-label"
                       for="@chck"
                       style="font-weight:normal; font-size:medium;">
                    @j. @Html.Raw(item.Task)
                </label>

                <div class="tab-content">
                    @Html.Raw(item.DetailTask)
                </div>

            </div>
        </div>

        i++;
        j++;
    }
}