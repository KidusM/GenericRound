@model CSMS.Models.ScChecklist

@{
    ViewData["Title"] = "Details";
}

<h2>Details</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <div>

            
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Number)
                </dt>
                <dd><textarea readonly class="form-control" style="color:black;background:white" rows="1">@Html.DisplayFor(model => model.Number)</textarea> 
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.Time)
                </dt>
                <dd>
                    <textarea readonly class="form-control" style="color:black;background:white" rows="1">@Html.DisplayFor(model => model.Time)</textarea>
                    
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.Task)
                </dt>
                <dd>
                    <textarea  readonly class="form-control" style="color:black;background:white" rows="3">@Html.DisplayFor(model => model.Task)</textarea>
                    
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.DetailTask)
                </dt>
                <dd>
                    <textarea  readonly class="form-control" style="color:black;background:white" rows="10">@Html.DisplayFor(model => model.DetailTask)</textarea>
                    
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.CbId)
                </dt>
                <dd>
                    <textarea  readonly class="form-control" style="color:black;background:white" rows="1">@Html.DisplayFor(model => model.CbId)</textarea>
                    
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.DetailTaskG1)
                </dt>
                <dd>
                    <textarea readonly  class="form-control" style="color:black;background:white" rows="10">@Html.DisplayFor(model => model.DetailTaskG1)</textarea>
                    
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.GroupId)
                </dt>
                <dd>
                    <textarea  readonly class="form-control" style="color:black;background:white" rows="1">@Html.DisplayFor(model => model.GroupId)</textarea>
                    
                </dd>
            </dl>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary" />Edit</a>
            <a asp-action="Index" class="btn btn-info" /> Back to List</a>
        </div>
    </div>
</div>