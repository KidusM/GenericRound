            </div>

            <div class="form-group mb-2">
                <label>Step Details</label>
                <textarea name="Steps[${index}].StepDetails"
                          class="form-control"
                          rows="5"></textarea>
            </div>

            <input type="hidden"
                   name="Steps[${index}].ScreenshotPath"
                   class="screenshot-path" />

            <input type="hidden"
                   name="Steps[${index}].ScreenshotBase64"
                   class="screenshot-base64" />

            <div class="border rounded p-3 mt-3 paste-area"
                 tabindex="0"
                 style="cursor:pointer; background:#f8f9fa;">
                Click here, then paste screenshot with Ctrl + V
            </div>

            <img class="img-fluid mt-2 border rounded screenshot-preview"
