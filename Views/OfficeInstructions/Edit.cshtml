            //    </div>
            //`;

            var html = `
    <div class="card mb-3 step-card">
        <div class="card-body">

            <h5>Step ${index + 1}</h5>

            <input type="hidden"
                   name="Steps[${index}].StepNumber"
                   value="${index + 1}" />

            <div class="form-group mb-2">
                <label>Step Title</label>
                <input name="Steps[${index}].StepTitle"
