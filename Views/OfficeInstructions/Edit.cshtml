            <button type="button"
                    class="btn btn-danger btn-sm mt-2"
                    onclick="removeStep(this)">
                Remove Step
            </button>

        </div>
    </div>
`;


            container.insertAdjacentHTML("beforeend", html);
            reindexSteps();
        }

        function removeStep(button) {
            button.closest(".step-card").remove();
            reindexSteps();
        }

        //function reindexSteps() {
        //    var cards = document.querySelectorAll(".step-card");

        //    cards.forEach(function (card, index) {
        //        card.querySelector("h5").innerText = "Step " + (index + 1);

        //        card.querySelectorAll("input, textarea").forEach(function (field) {
        //            if (field.name.includes(".StepNumber")) {
        //                field.name = "Steps[" + index + "].StepNumber";
        //                field.value = index + 1;
        //            }

        //            if (field.name.includes(".StepTitle")) {
        //                field.name = "Steps[" + index + "].StepTitle";
        //            }

        //            if (field.name.includes(".StepDetails")) {
        //                field.name = "Steps[" + index + "].StepDetails";
        //            }
        //        });
        //    });
        //}

        function reindexSteps() {
            var cards = document.querySelectorAll(".step-card");

            cards.forEach(function (card, index) {
                card.querySelector("h5").innerText = "Step " + (index + 1);

                card.querySelectorAll("input, textarea").forEach(function (field) {
                    if (field.name.includes(".StepNumber")) {
                        field.name = "Steps[" + index + "].StepNumber";
                        field.value = index + 1;
                    }

                    if (field.name.includes(".StepTitle")) {
                        field.name = "Steps[" + index + "].StepTitle";
                    }

                    if (field.name.includes(".StepDetails")) {
                        field.name = "Steps[" + index + "].StepDetails";
                    }

                    if (field.name.includes(".ScreenshotPath")) {
                        field.name = "Steps[" + index + "].ScreenshotPath";
                    }

                    if (field.name.includes(".ScreenshotBase64")) {
                        field.name = "Steps[" + index + "].ScreenshotBase64";
                    }
                });
            });
        }


        document.addEventListener("paste", function (event) {
            var activeElement = document.activeElement;

            if (!activeElement.classList.contains("paste-area")) {
                return;
            }

            var items = event.clipboardData.items;

            for (var i = 0; i < items.length; i++) {
                if (items[i].type.indexOf("image") !== -1) {
                    var file = items[i].getAsFile();

                    var reader = new FileReader();

                    reader.onload = function (e) {
                        var card = activeElement.closest(".step-card");

                        var base64Input = card.querySelector(".screenshot-base64");
                        var preview = card.querySelector(".screenshot-preview");

                        base64Input.value = e.target.result;

                        preview.src = e.target.result;
                        preview.style.display = "block";
                    };

                    reader.readAsDataURL(file);
                }
            }
        });
    </script>
}