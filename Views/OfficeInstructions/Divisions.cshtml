@model List<CSMS.Models.OfficeInstructionDivision>

@{
    ViewData["Title"] = "Office Instruction Divisions";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Office Instruction Divisions</h2>

        @if (isAdmin)
        {
            <a class="btn btn-primary" asp-action="CreateDivision" >
                Add Division
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No division has been created yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var division in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5>@division.Name</h5>

                            <a class="btn btn-outline-primary"
                               asp-action="PassKey"
                               asp-route-divisionKey="@division.Key">
                                Open Instructions
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>