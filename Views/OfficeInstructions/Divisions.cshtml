@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<CSMS.Models.OfficeInstructionDivision>

@{
    ViewData["Title"] = "Business Process by Division";

    string role = HttpContextAccessor.HttpContext.Session.GetString("_userRole");

    bool isAdmin =
        role == "SiteAdmin" ||
        role == "SuperSiteAdmin";

    bool isSuperSiteAdmin =
        role == "SuperSiteAdmin";

}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Business Process by Division</h2>

        @if (isSuperSiteAdmin)
        {
            <a class="btn btn-primary" asp-action="CreateDivision">
                Add Division
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No division has been created yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var division in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100 position-relative">

                        @if (isSuperSiteAdmin)
                        {
                            <form asp-action="DeleteDivision"
                                  asp-route-divisionKey="@division.Key"
                                  method="post"
                                  class="position-absolute"
                                  style="top: 8px; right: 8px; z-index: 2;"
                                  onsubmit="return confirm('Are you sure you want to delete this entire division and all its activities?');">

                                <button type="submit"
                                        class="btn btn-sm btn-light border text-danger rounded-circle"
                                        title="Remove Division"
                                        style="width: 32px; height: 32px; line-height: 1;">
                                    &times;
                                </button>
                            </form>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title pr-4">
                                @division.Name
                            </h5>

                            <p class="text-muted small flex-grow-1">
                                View and manage step-by-step instructions for this division.
                            </p>

                            <a class="btn btn-outline-primary mt-auto"
                               asp-action="PassKey"
                               asp-route-divisionKey="@division.Key">
                                Manage Activities
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>