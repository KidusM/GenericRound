```cshtml
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http;

@using CSMS.Models
@model IQueryable<Survey>

@*@model IEnumerable<ScPricingData>*@

@*<div class="QuestionnairePageContainer">*@

@*@HttpContextAccessor.HttpContext.Session.SetString("_focalPointMonitoringDSID","")*@

<div class="card">
    <div class="card-body">
        <div class="row">

            <div class="col-2">
            </div>

            <div class="col-8">

                <div class="table-responsive">

                    <!-- ACTIVE SURVEYS -->
                    <table class="table table-sm table-light">
                        <thead class="thead-light">
                            <tr>
                                <th colspan="4"
                                    class="text-center"
                                    style="font-weight:bold">
                                    Active Surveys
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var item in Model)
                                {
                                    if (item.SurveyEnd >= DateTime.UtcNow &&
                                    item.SurveyBegin <= DateTime.UtcNow)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Ds.Country)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.SurveyType)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.SurveyMonth)
                                            </td>

                                            <td>
                                                <a type="button"
                                                   class="btn btn-outline-secondary btn-block"
                                                   style="display:block"
                                                   href="@Url.Action(
                                                                                                                                                             "MonitoringTool",
                                                                                                                                                             "Home",
                                                                                                                                                             new
                                                                                                                                                             {
                                                                                                                                                                 dsid = item.Dsid,
                                                                                                                                                                 number = item.NoOfStaff,
                                                                                                                                                                 round = item.Round
                                                                                                                                                             })">
                                        Response Rate
                                    </a>
                                </td>
                            </tr>
                                                        }
                                }
                            }
                        </tbody>
                    </table>


                    <br />


                    <!-- UPCOMING SURVEYS -->
                    <table class="table table-sm table-light">

                        <thead class="thead-light">
                            <tr>
                                <th colspan="4"
                                    class="text-center"
                                    style="font-weight:bold">
                                    Upcoming Surveys
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var item in Model)
                                {
                                    if (item.SurveyBegin >= DateTime.UtcNow)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Ds.Country)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.SurveyType)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.SurveyMonth)
                                            </td>

                                            <td>
                                                <a type="button"
                                                   class="btn btn-outline-secondary btn-block"
                                                   style="display:block"
                                                   href="@Url.Action(
                                                                                                                                                             "MonitoringTool",
                                                                                                                                                             "Home",
                                                                                                                                                             new
                                                                                                                                                             {
                                                                                                                                                                 dsid = item.Dsid,
                                                                                                                                                                 number = item.NoOfStaff,
                                                                                                                                                                 round = item.Round
                                                                                                                                                             })">
                                        Response Rate
                                    </a>
                                </td>
                            </tr>
                                                        }
                                }
                            }
                        </tbody>

                    </table>


                    <br />


                    <!-- PAST SURVEYS -->
                    <table class="table table-sm table-light">

                        <thead class="thead-light">
                            <tr>
                                <th colspan="4"
                                    class="text-center"
                                    style="font-weight:bold">
                                    Past Surveys
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var item in Model)
                                {
                                    if (item.SurveyEnd < DateTime.UtcNow)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Ds.Country)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.SurveyType)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.SurveyMonth)
                                            </td>

                                            <td>
                                                <a type="button"
                                                   class="btn btn-outline-secondary btn-block"
                                                   style="display:block"
                                                   href="@Url.Action("MonitoringTool","Home",new
                                                   {
                                                       dsid = item.Dsid,
                                                       number = item.NoOfStaff,
                                                       round = item.Round
                                                   })">
                                        Response Rate
                                    </a>
                                </td>
                            </tr>
                                                        }
                                }
                            }
                        </tbody>

                    </table>

                </div>
            </div>

            <div class="col-2">
            </div>

        </div>
    </div>
</div>
